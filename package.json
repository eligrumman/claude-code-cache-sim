{
  "name": "claude-code-cache-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Claude Code Simulator - deterministic cache-economy engine + Svelte UI, builds to one self-contained offline HTML.",
  "bin": {
    "cc-cache-report": "bin/cc-cache-report.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "report": "node bin/cc-cache-report.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^29.1.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^6.3.6",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "immer": "^10.1.3"
  }
}
